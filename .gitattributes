# 文本文件统一按 LF 存储，避免 Windows/Linux 换行差异污染 diff
* text=auto

# 批处理/PowerShell 必须保持 CRLF，否则 cmd 执行会出问题
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell 脚本必须保持 LF：Windows 上 core.autocrlf=true 时，
# 检出的 .sh 若带 CRLF，Git Bash 会报 $'\r': command not found（别人 clone 下来直接跑不了）
*.sh text eol=lf

# 二进制文件不做任何转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.exe binary
*.dll binary
*.zip binary
